{
  "$defs": {
    "Agent": {
      "additionalProperties": false,
      "properties": {
        "attrs": {
          "additionalProperties": true,
          "title": "Attrs",
          "type": "object"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "id"
      ],
      "title": "Agent",
      "type": "object"
    },
    "Effect": {
      "enum": [
        "allow",
        "deny",
        "require_approval",
        "error"
      ],
      "title": "Effect",
      "type": "string"
    },
    "Principal": {
      "additionalProperties": false,
      "properties": {
        "attrs": {
          "additionalProperties": true,
          "title": "Attrs",
          "type": "object"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "default": "user",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "Principal",
      "type": "object"
    },
    "Recorded": {
      "additionalProperties": false,
      "description": "What the runtime actually did, when the source knows. Never a decision input.",
      "properties": {
        "effect": {
          "anyOf": [
            {
              "$ref": "#/$defs/Effect"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "policy_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Hash"
        }
      },
      "title": "Recorded",
      "type": "object"
    },
    "Resource": {
      "additionalProperties": false,
      "properties": {
        "attrs": {
          "additionalProperties": true,
          "title": "Attrs",
          "type": "object"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type"
        }
      },
      "title": "Resource",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "title": "Format",
          "type": "string"
        },
        "locator": {
          "title": "Locator",
          "type": "string"
        }
      },
      "required": [
        "format",
        "locator"
      ],
      "title": "Source",
      "type": "object"
    },
    "Tool": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "server": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Server"
        },
        "type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type"
        }
      },
      "required": [
        "name"
      ],
      "title": "Tool",
      "type": "object"
    }
  },
  "$id": "https://permdiff.dev/schemas/v1/toolcall.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One recorded agent tool call. Every importer produces it; every evaluator consumes it.",
  "properties": {
    "agent": {
      "$ref": "#/$defs/Agent"
    },
    "arguments": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Arguments"
    },
    "context": {
      "additionalProperties": true,
      "title": "Context",
      "type": "object"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "principal": {
      "$ref": "#/$defs/Principal"
    },
    "recorded": {
      "$ref": "#/$defs/Recorded"
    },
    "resource": {
      "$ref": "#/$defs/Resource"
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/Source"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "tool": {
      "$ref": "#/$defs/Tool"
    }
  },
  "required": [
    "id",
    "timestamp",
    "principal",
    "agent",
    "tool"
  ],
  "title": "ToolCall",
  "type": "object"
}
